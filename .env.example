# Template for stories-bot-bothost/.env
# Copy to .env and fill real values. NEVER commit .env — it is git-ignored.

# === REQUIRED (bot fails to start without these) ===
# Telegram bot token from @BotFather
API_TOKEN=replace_me
# Fernet key (urlsafe base64, 32 bytes = 44 characters) for encrypting user
# VK tokens/credentials in DB. The key is generated ONCE and must stay stable,
# otherwise previously encrypted data cannot be decrypted.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: empty value or the literal placeholder "replace_me" CRASHES the bot
# at import (Fernet validation in config.py raises ValueError). The key value
# itself is never logged — error messages contain only length and placeholder flag.
# Paste the generated key after '=' below. NEVER commit the real key.
STORIES_ENCRYPTION_KEY=

# === OPTIONAL (defaults shown) ===
# VK_TOKEN=                     # fallback VK token (service/admin), optional
# VK app owner credentials (bug fix #1). Values come ONLY from the hosting
# panel / .env - never hardcoded, never logged. Placeholders below, do NOT
# commit real values.
# VK_APP_ID=replace_me         # VK application id; when set together with
#                              # VK_SECURE_KEY it becomes the direct-auth default
# VK_SECURE_KEY=replace_me     # VK application secure key (direct-auth default)
# VK_SERVICE_KEY=replace_me    # app service key: LAST fallback token tier;
#                              # stories.get does NOT work with it (error 28)
# DB_PATH=vk_stories.db
# CHECK_INTERVAL_SECONDS=120
# TOKEN_CHECK_SECONDS=1200
# TIKTOK_CHECK_SECONDS=300
# TIKTOK_INITIAL_SYNC_GAP_SECONDS=300
# TG_SEND_DELAY_SECONDS=0.35
# VK_API_TIMEOUT_SECONDS=20
# HTTP_RETRIES=4
# YTDLP_SOCKET_TIMEOUT_SECONDS=30
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
# TIKTOK_MAX_MEDIA_PER_USER=0
# LOG_LEVEL=INFO

# === VK login by password (direct auth, 2FA + captcha) ===
# Works OUT OF THE BOX: by default the bot uses the PUBLIC credentials embedded
# in the official VK Android client (2274003) - these are widely known public
# constants, not a user secret.
# VK_DIRECT_AUTH_CLIENT_ID=               # optional: own VK app id; default = public 2274003
# VK_DIRECT_AUTH_CLIENT_SECRET=           # optional: own VK app secret; default = public official-client constant
# NOTE: VK_DIRECT_AUTH_CLIENT_ID / VK_DIRECT_AUTH_CLIENT_SECRET are OPTIONAL.
# By default the public credentials of the official VK Android client (2274003)
# are used. Override them with your own only if VK does not block those defaults
# for you (e.g. your own app was blocked / profile not verified). If you do set
# them, keep real values only in .env (never commit).
# VK_DIRECT_AUTH_SCOPE=stories
# VK_LOGIN_ENABLED=1                      # 0 = disable the VK password login flow
# VK_STORE_PASSWORD=0                     # 1 = also save encrypted login/password (optional, recommended 0)
# INSTAGRAM_SESSIONS_DIR=./ig_sessions
# TIKTOK_COOKIES_FILE=                    # Netscape cookie file for yt-dlp (optional)
#
# === TikTok delivery tuning (stage 3) ===
# TIKTOK_FFMPEG_LOCATION=/usr/bin/ffmpeg  # path to ffmpeg; empty = autodetect in PATH
# TIKTOK_POST_TIMEOUT_SECONDS=240         # per-post budget (download + send)
# TIKTOK_CYCLE_TIMEOUT_SECONDS=900        # whole monitoring cycle budget
# TIKTOK_RATE_LIMIT_BACKOFF_SECONDS=300   # pause on HTTP 429 / TikTok rate limit
# TIKTOK_RETRY_BACKOFF_BASE_SECONDS=2.0   # base for exponential download retry backoff
# TIKTOK_RETRY_BACKOFF_MAX_SECONDS=120    # max pause for exponential backoff
# TIKTOK_LOGIN_ENABLED=0                  # enable TikTok login via playwright (optional module)
# TIKTOK_LOGIN_HEADLESS=1                 # run login browser headless
# NOTE: per-user TikTok login credentials are stored encrypted in the DB, not here.
# playwright is OPTIONAL and not in requirements.txt. To enable TIKTOK_LOGIN_ENABLED=1:
#   pip install playwright && playwright install chromium
# Per-user TikTok cookies are converted to a Netscape cookiefile for yt-dlp automatically.
